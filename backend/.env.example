# Copy to backend/.env and fill in your own values. NEVER commit .env.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/hotel_erp?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_32_plus_character_secret
JWT_EXPIRES_IN=1d
# Used once by npm run seed:admin. Choose a NEW password, not one shared in chat.
ADMIN_NAME=Hotel Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_new_password
